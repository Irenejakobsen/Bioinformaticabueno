   "source": [
    "#### 14.- Crea el archivo _usuarios.json_con el contenido del diccionario _datos_. Abre el archivo de nuevo y convierte todos los nombres a mayúsculas, luego crea un archivo _usuarios.csv_ con formato:\n",
    "- id,nombre,roles\n",
    "- 1,ANA,user|admin\n",
    "- 2,LUIS,user\n",
    "- 3,MARTA,moderator|user"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 54,
   "id": "0447d160-c969-49dc-9ac9-63b30d340edf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "usuarios.cvs creado correctamente\n"
     ]
    }
   ],
   "source": [
    "import json\n",
    "import csv\n",
    "\n",
    "datos = [\n",
    "    {\"id\": 1, \"nombre\": \"ana\", \"puntos\": (10, 20, 30)},\n",
    "    {\"id\": 2, \"nombre\": \"luis\", \"puntos\": (5, 15)},\n",
    "    {\"id\": 3, \"nombre\": \"marta\", \"puntos\": (100, 50, 25)}\n",
    "]\n",
    "\n",
    "with open (\"usuarios.json\", \"w\", encoding=\"utf-8\") as archivo:\n",
    "    json.dump(datos, archivo, ensure_ascii=False, indent=4)\n",
    "\n",
    "with open (\"usuarios.json\", \"r\", encoding=\"utf-8\") as archivo:\n",
    "    usuarios = json.load(archivo)\n",
    "\n",
    "for usuario in usuarios:\n",
    "    usuario[\"nombre\"] = usuario[\"nombre\"].upper()\n",
    "\n",
    "with open(\"usuarios.csv\", \"w\", newline =\"\", encoding=\"utf-8\") as archivo_csv:\n",
    "    escritor = csv.writer(archivo_csv)\n",
    "    \n",
    "    escritor.writerow([\"id\", \"nombre\", \"puntos\"])\n",
    "    for usuario in usuarios:\n",
    "        escritor.writerow([\n",
    "            usuario[\"id\"],\n",
    "            usuario[\"nombre\"],\n",
    "            \"|\".join(map(str, usuario[\"puntos\"]))\n",
    "        ])\n",
    "\n",
    "print(\"usuarios.cvs creado correctamente\")"
   ]
  },
